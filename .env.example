# Copy to .env and fill in. .env is gitignored.
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=summarizer_db

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GROQ_API_KEY=your-groq-api-key

# --- Sessions and CORS -------------------------------------------------------------------------
# Local development over http: keep COOKIE_SECURE=false. In production set COOKIE_SECURE=true, and
# COOKIE_SAMESITE=none if the frontend and the API are on different sites (e.g. vercel.app and
# onrender.com). CORS_ALLOWED_ORIGINS must list the frontend origin(s) exactly.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Email (verification and password reset) -----------------------------------------------------
# MAIL_PROVIDER=log   prints the emailed links to the go-api log (fine for local development)
# MAIL_PROVIDER=brevo uses Brevo (https://www.brevo.com): BREVO_API_KEY plus a sender verified there
# MAIL_PROVIDER=resend uses Resend (https://resend.com):  RESEND_API_KEY plus a verified domain
MAIL_PROVIDER=log
MAIL_FROM=Inkling <noreply@example.com>
BREVO_API_KEY=
RESEND_API_KEY=
# Set true to require a confirmed email before summarizing (needs a real mail provider).
REQUIRE_EMAIL_VERIFICATION=false

# --- Two-step sign-in (authenticator app) --------------------------------------------------------------
# The secrets of authenticator apps are kept encrypted with this key, which is not in the database, so a copy of the
# database does not give out working codes. Make one with:  openssl rand -base64 32
# Empty: two-step sign-in is not offered. Keep the key safe and do not change it: the codes of everyone who switched
# two-step on stop working (their recovery codes still do) and they would have to be switched off in the database.
TOTP_ENCRYPTION_KEY=

# --- Abuse protection --------------------------------------------------------------------------------
# Cloudflare Turnstile (https://www.cloudflare.com/products/turnstile/): leave empty to disable.
# Also set NEXT_PUBLIC_TURNSTILE_SITE_KEY in frontend/.env.local.
TURNSTILE_SECRET=
# Daily limits per signed-in user (UTC day). 0 means unlimited.
QUOTA_SUMMARIES_PER_DAY=50
QUOTA_CHAT_PER_DAY=200
# Spending guard: summaries one visitor without an account may make a day, and all the AI work the whole site may
# start a day (it pauses until midnight UTC when used up). 0 means unlimited.
ANON_SUMMARIES_PER_DAY=10
AI_REQUESTS_PER_DAY=5000

# --- Operations (all optional) -------------------------------------------------------------------
# Shared secret between the Go API and the AI service. Leave empty on a private network (compose);
# set the same long random value on both when the AI service is reachable from the internet.
AI_SERVICE_TOKEN=
# Searching documents by meaning runs a small model inside the AI service (about 200 MB of memory).
# EMBEDDINGS=off turns it off: search is then by keyword only. A larger EMBEDDING_MODEL finds more
# but needs more memory; EMBEDDING_MIN_SCORE overrides the model's default similarity floor.
EMBEDDINGS=on
EMBEDDING_MODEL=
EMBEDDING_MIN_SCORE=
# Enables GET /metrics (Prometheus) on both backends, for callers sending "Authorization: Bearer <token>".
# Leave empty to switch the endpoint off. See docker-compose.observability.yml for a ready dashboard.
METRICS_TOKEN=
# Error reporting to Sentry; empty means nothing is sent. No request data or documents are attached.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Multiplies every request rate limit (1 = defaults).
RATE_LIMIT_MULTIPLIER=1
# Original PDFs kept per user so cited pages can be opened in the document viewer, in MB. 0 keeps none.
STORED_FILES_MB_PER_USER=100
